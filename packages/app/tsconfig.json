{
  "extends": "../../tsconfig.base.json",
  "include": [
    "./infra/**/*.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./src/css.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "public"],
  "compilerOptions": {
    "types": [
      "@types/node",
      "@cloudflare/workers-types",
      "./cloudflare-env.d.ts",
      "./next-env.d.ts"
    ],
    "rootDir": "./",
    "paths": {
      "@/infra/*": ["./infra/*"],
      "@/*": ["./src/*"]
    },
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "module": "esnext"
  }
}
