{
  "name": "solstatus-workerd-test-monitor-exec",
  "main": "../packages/api/src/monitor-exec.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "APP_ENV": "test",
    "OPSGENIE_API_KEY": "",
    "MONITOR_EXEC_NAME": "solstatus-workerd-test-monitor-exec",
    "MONITOR_TRIGGER_NAME": "solstatus-workerd-test-monitor-trigger",
    "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000000",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solstatus-workerd-test",
      "database_id": "solstatus-workerd-test",
    },
  ],
}
